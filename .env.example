# Copy to .env and fill in. Vite exposes VITE_ variables to the browser, so only put public keys here.

# Supabase project (auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# RAG backend (chat, uploads, health)
VITE_RAG_API_URL=

# StaticForms API key: the contact form emails its submissions through https://www.staticforms.dev
VITE_STATICFORMS_API_KEY=
